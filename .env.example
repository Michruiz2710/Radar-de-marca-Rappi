# Copiar a .env y completar. El archivo .env NUNCA se sube a Git.

# --- Entorno: dev | staging | prod ---
APP_ENV=dev

# --- MinIO (capa raw) ---
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=cambiar_usuario
MINIO_ROOT_PASSWORD=cambiar_contrasena_larga
MINIO_BUCKET=radar-rappi
MINIO_SECURE=false

# --- Capa raw: minio | local (local guarda en LOCAL_RAW_DIR, útil sin Docker) ---
RAW_BACKEND=minio
LOCAL_RAW_DIR=data

# --- Postgres (capas clean y analytics) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=radar
POSTGRES_USER=cambiar_usuario
POSTGRES_PASSWORD=cambiar_contrasena_larga

# --- Prefect (guarda su estado en su propia base dentro del mismo Postgres) ---
PREFECT_API_URL=http://prefect:4200/api
PREFECT_DB_NAME=prefect

# --- Privacidad: sal para el hash de autores (valor largo y aleatorio) ---
HASH_SALT=cambiar_por_cadena_aleatoria

# --- Google Play ---
GP_APP_ID=com.grability.rappi
GP_COUNTRY=co
GP_LANG=es
GP_MAX_REVIEWS_PER_RUN=500

# --- YouTube Data API v3 (la comparte Gabriel por mensaje privado) ---
YOUTUBE_API_KEY=
YT_QUERY=Rappi
YT_REGION=CO
YT_LANG=es
YT_MAX_SEARCHES_PER_DAY=3
YT_MAX_COMMENTS_PER_VIDEO=500
YT_QUOTA_BUDGET=8000
YT_BRAND_TERMS=rappi

# --- Google News RSS (fuente 3) ---
NEWS_QUERY=Rappi
NEWS_HL=es-419
NEWS_GL=CO

# --- Observabilidad ---
PUSHGATEWAY_URL=http://pushgateway:9091
# Puertos en tu computador (cámbialos si ya están ocupados)
PUSHGATEWAY_PORT=9091
PROMETHEUS_PORT=9090
DASHBOARD_PORT=8502
# --- Grafana (P3.2): dashboard técnico y alertas ---
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=cambiar_contrasena_larga
# Alertas por correo: a quién llegan (varias direcciones separadas por ;) y desde qué cuenta salen.
# Con Gmail: activa la verificación en dos pasos y crea una "contraseña de aplicación"
# (https://myaccount.google.com/apppasswords). Es un secreto: solo en tu .env y en los GitHub Environments.
ALERTAS_CORREO_DESTINO=
GRAFANA_SMTP_HOST=smtp.gmail.com:587
GRAFANA_SMTP_USER=
GRAFANA_SMTP_PASSWORD=
# Solo si un antivirus (Avast Mail Shield) cambia el certificado de Gmail y el correo falla con
# "x509: certificate signed by unknown authority". Mejor desactiva el escaneo en el antivirus.
GRAFANA_SMTP_SKIP_VERIFY=false

# --- Despliegue con imágenes publicadas (P2.5) ---
# Versión de las imágenes de ghcr.io que usa make desplegar: latest (lo último de main) o una etiqueta como v0.2.0
IMAGE_TAG=latest

# --- Sentimiento y temas (P2.4) ---
# Hash del commit del modelo pysentimiento/robertuito-sentiment-analysis en Hugging Face.
# Obtenerlo con: python -c "from huggingface_hub import HfApi; print(HfApi().model_info('pysentimiento/robertuito-sentiment-analysis').sha)"
NLP_MODEL_REVISION=a2cc0f67ebd705c55191e25a05ba23d885fcc09b
NLP_BATCH_SIZE=32
# Puerto de la consola web de MinIO. Cámbialo (por ejemplo a 9101) si el 9001 está ocupado o reservado (en Windows: Hyper-V/WSL).
MINIO_CONSOLE_PORT=9001
