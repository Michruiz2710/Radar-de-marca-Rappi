# Copiar a .env y completar. El archivo .env NUNCA se sube a Git.

# --- Entorno: dev | staging | prod ---
APP_ENV=dev

# --- MinIO (capa raw) ---
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=cambiar_usuario
MINIO_ROOT_PASSWORD=cambiar_contrasena_larga
MINIO_BUCKET=radar-rappi

# --- Postgres (capas clean y analytics) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=radar
POSTGRES_USER=cambiar_usuario
POSTGRES_PASSWORD=cambiar_contrasena_larga

# --- Prefect ---
PREFECT_API_URL=http://prefect:4200/api

# --- Privacidad: sal para el hash de autores (valor largo y aleatorio) ---
HASH_SALT=cambiar_por_cadena_aleatoria

# --- Google Play ---
GP_APP_ID=com.grability.rappi
GP_COUNTRY=co
GP_LANG=es
GP_MAX_REVIEWS_PER_RUN=500

# --- YouTube Data API v3 (la comparte Gabriel por mensaje privado) ---
YOUTUBE_API_KEY=
YT_QUERY=Rappi
YT_REGION=CO
YT_LANG=es
YT_MAX_SEARCHES_PER_DAY=3

# --- Google News RSS ---
NEWS_QUERY=Rappi
NEWS_HL=es-419
NEWS_GL=CO

# --- Observabilidad ---
PUSHGATEWAY_URL=http://pushgateway:9091
